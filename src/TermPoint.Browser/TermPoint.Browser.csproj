<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8632;IL2026;IL2057;IL2075;IL2104</NoWarn>
    <!-- Required: full trimming breaks Avalonia's reflection-based bindings and JSON serialization. -->
    <TrimMode>partial</TrimMode>
    <!-- Required with trimming on: System.Text.Json otherwise refuses reflection-based (de)serialization. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <WasmNativeOptimization>-O1</WasmNativeOptimization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TermPoint\TermPoint.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Must be the AssemblyName (TermPoint), not the project folder name. -->
    <TrimmerRootAssembly Include="TermPoint" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="wwwroot/index.html" TargetPath="index.html" />
    <WasmExtraFilesToDeploy Include="..\TermPoint\Help\**" TargetPath="Help/%(Filename)%(Extension)" />
    <WasmExtraFilesToDeploy Include="..\TermPoint\Assets\*.png" TargetPath="Assets/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
