<Application
	x:Class="TermPoint.App"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:conv="using:TermPoint.Converters"
	xmlns:local="using:TermPoint"
	RequestedThemeVariant="Light">

 
  
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://TermPoint/AppColors.axaml" />
				<ResourceInclude Source="avares://TermPoint/AppLayout.axaml" />
				<ResourceInclude Source="avares://TermPoint/Assets/Icons.axaml" />
				<ResourceInclude Source="avares://TermPoint/TourContent.axaml" />
			</ResourceDictionary.MergedDictionaries>
      
			<!--  Font sizes  -->
			<x:Double x:Key="FontSizeSmall">10</x:Double>
			<x:Double x:Key="FontSizeNormal">14</x:Double>
			<x:Double x:Key="FontSizeMedium">14</x:Double>
			<x:Double x:Key="FontSizeLarge">16</x:Double>
			<x:Double x:Key="FontSizeXLarge">18</x:Double>
			<x:Double x:Key="FontSizeSplash">72</x:Double>
			<!--  The schedule grid's filter popups: their checkbox lists and the Tags filter's all/any choice  -->
			<x:Double x:Key="FontSizeFilterPopup">11</x:Double>

			<!--  Tallest the Focus picker's subject checklist grows before it scrolls  -->
			<x:Double x:Key="FocusPickerListMaxHeight">220</x:Double>

			<!--  Widest the top bar's Subjects button grows before its text is trimmed (the tooltip shows the full list)  -->
			<x:Double x:Key="SubjectsButtonMaxWidth">220</x:Double>

			<!--
				Weight of the top bar's "where am I working" context: the Academic Year, Semester and Subjects labels and
				their chosen values. Heavier than the static menu items, so the user's current context stands out.
			-->
			<FontWeight x:Key="TopBarContextWeight">SemiBold</FontWeight>

			<!--  Tallest a list in the Import Sections flyout (problems, sections, courses, warnings...) grows before it scrolls  -->
			<x:Double x:Key="ImportListMaxHeight">200</x:Double>

			<!--  Font size of the Import Sections flyout's reading text: the sentences of the numbered steps and the instructions document  -->
			<x:Double x:Key="ImportReadingFontSize">12</x:Double>

			<!--  Longest line, in pixels, of the Import Sections flyout's first screen text and instructions document. The flyout is as wide as the window, so longer lines would be hard to read  -->
			<x:Double x:Key="ImportReadingMaxWidth">680</x:Double>

			<!--  Weight of headings inside flyout bodies (the Import Sections problems heading and the "New in TermPoint" group headings)  -->
			<FontWeight x:Key="FlyoutHeadingWeight">SemiBold</FontWeight>

			<!--  Font of the section card heading (e.g. "BIOL 105 AB1"). The section card heading should use these too; the subject colour chooser's preview chip already does  -->
			<x:Double x:Key="SectionHeadingFontSize">12</x:Double>
			<FontWeight x:Key="SectionHeadingFontWeight">SemiBold</FontWeight>

			<!--
				Subject marker (colour by subject, designs/subject-colours.md Revision 1): a small rounded square of the
				subject's colour before the section code, outlined with SubjectMarkerOutline (AppColors.axaml).
				SubjectMarkerSizeRatio: the marker's side as a fraction of the text's font size (close to the text height),
				used by the Schedule view tiles so the marker follows the grid's font-size selector.
				SubjectMarkerGap: pixels between a tile marker and the section code.
				SectionListSubjectMarkerSize: the marker's side on section cards and in the Courses flyout preview
				(the 12 pt card heading; 12 × the ratio, rounded).
				SectionListSubjectMarkerMargin: the card marker's margin. Its right side plus the heading's own 2 px left
				margin makes the same 3 px gap as on tiles.
			-->
			<x:Double x:Key="SubjectMarkerSizeRatio">0.9</x:Double>
			<x:Double x:Key="SubjectMarkerGap">3</x:Double>
			<CornerRadius x:Key="SubjectMarkerCornerRadius">2</CornerRadius>
			<Thickness x:Key="SubjectMarkerBorderThickness">1</Thickness>
			<x:Double x:Key="SectionListSubjectMarkerSize">11</x:Double>
			<Thickness x:Key="SectionListSubjectMarkerMargin">2,0,1,0</Thickness>

			<!--
				Subject chips in the Schedule View header's focus statement (1.2.4 item 2.14, Controls/FocusIndicator.axaml).
				FocusChipMarkerSize: the marker's side beside the 16 px header text (FontSizeLarge × SubjectMarkerSizeRatio, rounded).
				FocusChipSpacing: horizontal gap between chips; FocusChipLineSpacing: gap between wrapped lines.
				FocusChipLabelMaxWidth: widest a chip's name grows before it is trimmed (a subject with no abbreviation
				shows its full name); the chip's tooltip shows the full name.
			-->
			<x:Double x:Key="FocusChipMarkerSize">14</x:Double>
			<x:Double x:Key="FocusChipSpacing">6</x:Double>
			<x:Double x:Key="FocusChipLineSpacing">2</x:Double>
			<x:Double x:Key="FocusChipLabelMaxWidth">160</x:Double>

			<!--  Converters  -->
			<conv:MinutesToTimeConverter x:Key="MinutesToTimeConverter" />
			<conv:MultiSemesterLeftBorderThicknessConverter x:Key="MultiSemesterLeftBorderThicknessConverter" />
			<conv:FilterBorderThicknessConverter x:Key="FilterBorderThicknessConverter" />
			<conv:FilterHighlightBackgroundConverter x:Key="FilterHighlightBackgroundConverter" />
			<conv:SemesterBorderBrushConverter x:Key="SemesterBorderBrushConverter" />
			<conv:SemesterBackgroundBrushConverter x:Key="SemesterBackgroundBrushConverter" />
			<conv:HexToColorConverter x:Key="HexToColorConverter" />
			<conv:HexToBrushConverter x:Key="HexToBrushConverter" />
			<conv:NotConverter x:Key="NotConverter" />
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<SimpleTheme />
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Simple/Simple.xaml" />

		<!--
			Colour choosers (subjects, semesters, wizard): hide the ColorView's tab strip.
			Since the Avalonia 12 upgrade its tab icons and palette swatches render blank, leaving an empty
			pale band above the spectrum. Every chooser only needs the spectrum tab (the default tab), so the
			strip (the TabControl's header ItemsPresenter), its background band and the content's 48 px top
			offset are removed. Applies only inside ColorView templates, so no other control pays for it.
		-->
		<Style Selector="ColorView /template/ TabControl#PART_TabControl /template/ ItemsPresenter">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="ColorView /template/ Border#TabBackgroundBorder">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="ColorView /template/ Border#ContentBackgroundBorder">
			<Setter Property="Margin" Value="0" />
		</Style>

		<!--
			Inter is the application-wide font. It is registered as the default in
			Program.cs via .WithInterFont() — no explicit XAML style is needed.
		-->
		<!--  Flat buttons: no border, fill-based depth only.  -->

		<Style Selector="Button">
			<Setter Property="Background" Value="{StaticResource UserInteractionBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="Button:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ButtonHover}" />
		</Style>
		<Style Selector="Button:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ButtonPressed}" />
		</Style>
		<Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ButtonHover}" />
		</Style>
		<Style Selector="ToggleButton:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ButtonPressed}" />
		</Style>
		<Style Selector="ToggleButton:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ButtonPressed}" />
		</Style>
		<Style Selector="Button.nav">
			<Setter Property="Padding" Value="14,8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="FontSize" Value="13" />
		</Style>
		<Style Selector="Button.nav:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ButtonHover}" />
		</Style>

		<!--
			Active-state highlight for nav buttons. Applied via Classes.active binding
			(e.g. the "More…" button stays highlighted while the More flyout is open).
		-->
		<Style Selector="Button.nav.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ButtonHover}" />
		</Style>

		<!--  Settings menu: strip chrome from the Menu container itself  -->
		<Style Selector="Menu">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<!--  Top-level MenuItem styled like a nav button  -->
		<Style Selector="MenuItem.nav">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="CornerRadius" Value="4" />
			<Style.Resources>
				<SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource ButtonHoverColor}" />
				<SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource ButtonPressedColor}" />
			</Style.Resources>
		</Style>

		<Style Selector="TextBlock">
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>

		<!--  ScrollBar track background  -->
		<Style Selector="ScrollBar /template/ Border#PART_Root">
			<Setter Property="Background" Value="{StaticResource ChromeBackground}" />
		</Style>

		<!--  DataGrid row selection highlight (visible across all grids)  -->
		<Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
			<Setter Property="Fill" Value="{StaticResource ListRowSelectedBackground}" />
			<Setter Property="Opacity" Value="1" />
		</Style>

		<!--
			Direct-input controls: any control where the user types or picks a value
			gets UserInteractionColor as background so it stands out against panel surfaces.
			ButtonBackground is the brush version of UserInteractionColor.
			Views that need different behavior can override with a local Style.
		-->
		<Style Selector="TextBox">
			<Setter Property="Background" Value="{StaticResource UserInteractionBrush}" />
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Background" Value="{StaticResource UserInteractionBrush}" />
		</Style>
		<Style Selector="AutoCompleteBox">
			<Setter Property="Background" Value="{StaticResource UserInteractionBrush}" />
		</Style>
		<Style Selector="CheckBox /template/ Border#NormalRectangle">
			<Setter Property="Background" Value="{StaticResource UserInteractionBrush}" />
		</Style>

		<!--
			Meeting-row dropdown with nothing chosen (it shows "—"). Each dropdown binds Classes.unset
			to its row's IsXxxUnset property. Grey like a text placeholder, with a tooltip saying the
			choice hasn't been made. Items in the open dropdown keep the normal text colour.
		-->
		<Style Selector="ComboBox.unset">
			<Setter Property="Foreground" Value="{StaticResource UnsetChoiceText}" />
			<Setter Property="ToolTip.Tip" Value="Not specified" />
		</Style>
		<Style Selector="ComboBox.unset ComboBoxItem">
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>

	</Application.Styles>

	<Application.DataTemplates>
		<local:ViewLocator />
	</Application.DataTemplates>

</Application>