<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TermPoint.ViewModels"
             x:Class="TermPoint.Views.SupportView"
             x:DataType="vm:SupportViewModel"
             x:CompileBindings="False">

    <!--
        Support panel (Dev Tools → Support..., desktop only). Two voluntary helps for a user who has emailed about a
        problem: save logs as one zip to attach to the email, and show the Support ID (the anonymous install ID every
        BugSnag report carries). Nothing is sent from here. Sentences built in code are in SupportMessages.
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" Spacing="18" MaxWidth="{StaticResource SupportReadingMaxWidth}" HorizontalAlignment="Left">

            <TextBlock TextWrapping="Wrap"
                       FontSize="{StaticResource SupportFontSize}"
                       Foreground="{StaticResource TextSecondary}"
                       Text="If you've emailed about a problem, these help the developer look into it. Nothing is sent from here: you choose what to attach to your email." />

            <!-- Logs -->
            <StackPanel Spacing="8">
                <TextBlock Text="Logs"
                           FontSize="{StaticResource SectionHeadingFontSize}"
                           FontWeight="{StaticResource SectionHeadingFontWeight}"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock TextWrapping="Wrap"
                           FontSize="{StaticResource SupportFontSize}"
                           Foreground="{StaticResource TextSecondary}"
                           Text="TermPoint's daily record of what it did. Logs include the names of folders and files TermPoint used, but not what's in them: none of your courses, sections, instructors or other scheduling data. Tick the days to include, then save them and attach the file to your email." />

                <ItemsControl ItemsSource="{Binding Logs}" IsVisible="{Binding HasLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      Content="{Binding Label}"
                                      FontSize="{StaticResource SupportFontSize}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock IsVisible="{Binding !HasLogs}"
                           FontSize="{StaticResource SupportFontSize}"
                           Foreground="{StaticResource TextFaint}"
                           Text="There are no logs on this computer yet." />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save logs..."
                            Command="{Binding SaveLogsCommand}"
                            IsEnabled="{Binding HasLogs}"
                            FontSize="{StaticResource SupportFontSize}" />
                    <Button Content="Show in folder"
                            Command="{Binding ShowInFolderCommand}"
                            IsVisible="{Binding HasSavedZip}"
                            FontSize="{StaticResource SupportFontSize}" />
                </StackPanel>

                <!-- Two TextBlocks rather than a class-conditioned style: one shows a success, the other a problem. -->
                <TextBlock Text="{Binding LogsStatus}"
                           IsVisible="{Binding !IsLogsStatusError}"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource SupportFontSize}"
                           Foreground="{StaticResource TextFaint}" />
                <TextBlock Text="{Binding LogsStatus}"
                           IsVisible="{Binding IsLogsStatusError}"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource SupportFontSize}"
                           Foreground="{StaticResource TextError}" />
            </StackPanel>

            <!-- Support ID -->
            <StackPanel Spacing="8">
                <TextBlock Text="Support ID"
                           FontSize="{StaticResource SectionHeadingFontSize}"
                           FontWeight="{StaticResource SectionHeadingFontWeight}"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock TextWrapping="Wrap"
                           FontSize="{StaticResource SupportFontSize}"
                           Foreground="{StaticResource TextSecondary}"
                           Text="Lets the developer match error reports from this computer to your email. It contains nothing about you or your data. Each computer has its own." />

                <Button Content="Show Support ID"
                        Command="{Binding ShowSupportIdCommand}"
                        IsVisible="{Binding !IsSupportIdShown}"
                        FontSize="{StaticResource SupportFontSize}" />

                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSupportIdShown}">
                    <TextBox Text="{Binding SupportId, Mode=OneWay}"
                             IsReadOnly="True"
                             MinWidth="300"
                             FontSize="{StaticResource SupportFontSize}" />
                    <Button Content="Copy"
                            Command="{Binding CopySupportIdCommand}"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource SupportFontSize}" />
                </StackPanel>
                <TextBlock Text="{Binding SupportIdStatus}"
                           IsVisible="{Binding SupportIdStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="{StaticResource SupportFontSize}"
                           Foreground="{StaticResource TextFaint}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
