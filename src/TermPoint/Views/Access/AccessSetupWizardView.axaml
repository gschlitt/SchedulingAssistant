<UserControl
	x:Class="TermPoint.Views.Access.AccessSetupWizardView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:h="using:TermPoint.Helpers"
	x:CompileBindings="False">

	<!--
		The access setup wizard (Access Analyzer revision 8f), shown as a flyout page rather than a window: it works in
		the WASM demo and avoids the picker/window-dispose deadlock. DataContext: AccessSetupWizardViewModel. One panel
		per step, shown by the view model's step flags; the course table is shared by the setup's course check and the
		"new type" follow-up. All wording comes from AccessText (approved for coding; Greg will fine-tune it).
	-->
	<UserControl.Resources>
		<!--  The course table's column widths: course code, then one box column per component type  -->
		<x:Double x:Key="WizardCodeColumnWidth">90</x:Double>
		<x:Double x:Key="WizardBoxColumnWidth">76</x:Double>
		<!--  The course rows' scroll height (the headings stay above it)  -->
		<x:Double x:Key="WizardCourseTableMaxHeight">400</x:Double>
	</UserControl.Resources>

	<DockPanel Margin="10,0,10,8">

		<TextBlock
			Margin="0,0,0,12"
			DockPanel.Dock="Top"
			FontSize="{StaticResource FontSizeXLarge}"
			FontWeight="SemiBold"
			Foreground="{StaticResource TextPrimary}"
			Text="{Binding Title}"
			TextWrapping="Wrap" />

		<!--  Buttons: each shown only on the steps that have it  -->
		<StackPanel
			Margin="0,10,0,0"
			DockPanel.Dock="Bottom"
			Orientation="Horizontal"
			Spacing="8">
			<Button Command="{Binding BackCommand}" Content="Back" IsVisible="{Binding ShowBack}" />
			<Button
				Command="{Binding NextCommand}"
				Content="Next"
				IsVisible="{Binding ShowNext}"
				ToolTip.ShowOnDisabled="True"
				ToolTip.Tip="{Binding NextDisabledTip}" />
			<Button Command="{Binding FinishCommand}" Content="Finish" IsVisible="{Binding ShowFinish}" />
			<Button Command="{Binding TheseAreRightCommand}" Content="These are right" IsVisible="{Binding ShowTheseAreRight}" />
			<Button Command="{Binding SaveCommand}" Content="Save" IsVisible="{Binding ShowSave}" />
			<Button Command="{Binding CancelCommand}" Content="{Binding SkipText}" IsVisible="{Binding ShowSkip}" />
			<Button Command="{Binding CancelCommand}" Content="Cancel" IsVisible="{Binding ShowCancel}" />
			<Button Command="{Binding CancelCommand}" Content="Close" IsVisible="{Binding ShowClose}" />
		</StackPanel>

		<!--  A save that failed (nothing was written)  -->
		<TextBlock
			Margin="0,8,0,0"
			DockPanel.Dock="Bottom"
			FontSize="{StaticResource FontSizePanelList}"
			Foreground="{StaticResource TextValidationError}"
			IsVisible="{Binding LastErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
			Text="{Binding LastErrorMessage}"
			TextWrapping="Wrap" />

		<Panel>
			<!--  Question 1: do students register in more than one section of a course?  -->
			<StackPanel IsVisible="{Binding IsQuestionStep}" Spacing="8">
				<TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="{Binding Question}" TextWrapping="Wrap" />
				<TextBlock Foreground="{StaticResource TextPrimary}" Text="{Binding Example}" TextWrapping="Wrap" />
				<TextBlock h:InlineFormatter.Text="{Binding ParallelCourses}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
				<RadioButton Content="{Binding YesLabel}" GroupName="AccessWizardAnswer" IsChecked="{Binding IsYes}" />
				<RadioButton Content="{Binding NoLabel}" GroupName="AccessWizardAnswer" IsChecked="{Binding IsNo}" />
			</StackPanel>

			<!--  Question 2: which section types mark a component?  -->
			<StackPanel IsVisible="{Binding IsTypesStep}" Spacing="8">
				<TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="{Binding TypesQuestion}" TextWrapping="Wrap" />
				<TextBlock Foreground="{StaticResource TextPrimary}" Text="{Binding TypesText}" TextWrapping="Wrap" />
				<ItemsControl ItemsSource="{Binding TypeRows}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<CheckBox Margin="0,0,14,0" Content="{Binding Name}" IsChecked="{Binding IsTicked}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<Button
					Padding="0"
					HorizontalAlignment="Left"
					Background="Transparent"
					BorderThickness="0"
					Command="{Binding TypesFirstCommand}">
					<TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding TypesFirstLinkText}" TextDecorations="Underline" />
				</Button>
			</StackPanel>

			<!--  "Set up your section types first": nothing saved  -->
			<TextBlock
				Foreground="{StaticResource TextPrimary}"
				IsVisible="{Binding IsTypesFirstStep}"
				Text="{Binding TypesFirstText}"
				TextWrapping="Wrap" />

			<!--  The course check (setup) and the follow-up after marking a type: every course, one box per component type  -->
			<DockPanel IsVisible="{Binding IsCourseTable}">
				<TextBlock
					Margin="0,0,0,8"
					DockPanel.Dock="Top"
					Foreground="{StaticResource TextPrimary}"
					Text="{Binding CourseTableText}"
					TextWrapping="Wrap" />
				<TextBlock
					Margin="0,8,0,0"
					DockPanel.Dock="Bottom"
					FontSize="{StaticResource FontSizePanelList}"
					Foreground="{StaticResource TextFaint}"
					Text="{Binding CoursesFootnote}"
					TextWrapping="Wrap" />

				<!--  Column headings  -->
				<StackPanel Margin="0,0,0,2" DockPanel.Dock="Top" Orientation="Horizontal">
					<TextBlock
						Width="{StaticResource WizardCodeColumnWidth}"
						FontSize="{StaticResource FontSizePanelList}"
						FontWeight="SemiBold"
						Foreground="{StaticResource TextSecondary}"
						Text="Course" />
					<ItemsControl ItemsSource="{Binding ColumnHeadings}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<TextBlock
									Width="{StaticResource WizardBoxColumnWidth}"
									FontSize="{StaticResource FontSizePanelList}"
									FontWeight="SemiBold"
									Foreground="{StaticResource TextSecondary}"
									Text="{Binding}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									ToolTip.Tip="{Binding}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<!--  Capped so the course rows scroll here, under the headings: the flyout hosts its page in a ScrollViewer,
				      so without a cap this one would grow to fit and the headings would scroll away with the rows.  -->
				<ScrollViewer MaxHeight="{StaticResource WizardCourseTableMaxHeight}" VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding CourseRows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<!--  A highlighted row has sections of the type just marked (new-type mode)  -->
								<Panel>
									<Border Background="{StaticResource ListRowSelectedBackground}" IsVisible="{Binding IsHighlighted}" />
									<StackPanel Margin="0,1" Orientation="Horizontal">
										<TextBlock
											Width="{StaticResource WizardCodeColumnWidth}"
											VerticalAlignment="Center"
											FontSize="{StaticResource FontSizePanelList}"
											Foreground="{StaticResource TextPrimary}"
											Text="{Binding Code}"
											TextTrimming="CharacterEllipsis" />
										<ItemsControl ItemsSource="{Binding Cells}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Panel Width="{StaticResource WizardBoxColumnWidth}">
														<CheckBox MinHeight="0" HorizontalAlignment="Center" IsChecked="{Binding IsTicked}" />
													</Panel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Panel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
		</Panel>
	</DockPanel>
</UserControl>
