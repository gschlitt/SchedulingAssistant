<UserControl
    x:Class="TermPoint.Views.Management.SchedulingEnvironmentListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="using:TermPoint.Behaviors"
    xmlns:vm="using:TermPoint.ViewModels.Management"
    x:CompileBindings="False"
    x:DataType="vm:SchedulingEnvironmentListViewModel">

    <Grid
        MaxWidth="420"
        Margin="10,0"
        RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,6"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{Binding DisplayName}" />

        <StackPanel Grid.Row="1" Margin="0,0,0,10" Spacing="6">
            <!--  Per-type description — hidden when Description is null or empty  -->
            <TextBlock
                FontSize="{StaticResource FontSizeNormal}"
                Foreground="{StaticResource TextSecondary}"
                IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Text="{Binding Description}"
                TextWrapping="Wrap" />
            <!--  Section Type, until a Component box is saved: the ticks are TermPoint's guess  -->
            <TextBlock
                FontSize="{StaticResource FontSizeNormal}"
                Foreground="{StaticResource TextAttention}"
                IsVisible="{Binding ShowComponentGuessNote}"
                Text="{Binding ComponentGuessNote}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Edit form (shown when EditVm is not null)  -->
        <ContentControl Grid.Row="2" Content="{Binding EditVm}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:SchedulingEnvironmentEditViewModel}">
                    <StackPanel
                        MaxWidth="320"
                        HorizontalAlignment="Left"
                        Spacing="10">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding Title}" />
                        <TextBlock Text="Name" />
                        <TextBox Text="{Binding Name}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextError}"
                            IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Text="{Binding ValidationError}" />
                        <!--  Abbreviation field — only shown for Campus  -->
                        <StackPanel IsVisible="{Binding ShowAbbreviation}" Spacing="4">
                            <TextBlock Text="Section Code Abbreviation" />
                            <TextBox Text="{Binding Abbreviation}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding SaveCommand}" Content="Apply" />
                            <Button Command="{Binding CancelCommand}" Content="Cancel" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!--  List + move buttons (shown when EditVm is null)  -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto"
            IsVisible="{Binding EditVm, Converter={x:Static ObjectConverters.IsNull}}">

            <DataGrid
                x:Name="EnvironmentDataGrid"
                b:DoubleTapCommandBehavior.Command="{Binding EditCommand}"
                Grid.Column="0"
                AutoGenerateColumns="False"
                CanUserSortColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Name}"
                        Header="Name" />
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding SectionCodeAbbreviation}"
                        Header="Abbreviation"
                        IsVisible="{Binding $parent[UserControl].DataContext.ShowAbbreviation}" />
                    <!--
                        Tags only: the Access watch eye (D26, D28; second place after the Tags popup). Disabled read-only.
                        Rows are the tag records themselves; ToggleWatchCommand refreshes Items so the eye redraws.
                    -->
                    <DataGridTemplateColumn IsVisible="{Binding $parent[UserControl].DataContext.ShowWatchColumn}">
                        <DataGridTemplateColumn.Header>
                            <StackPanel
                                Background="Transparent"
                                Orientation="Horizontal"
                                Spacing="3"
                                ToolTip.Tip="An access watch monitors a selection of courses for student access.">
                                <Path Width="13" Height="13" VerticalAlignment="Center" Data="{StaticResource AccessWatchEyeIcon}" Stretch="Uniform" Stroke="{StaticResource AccessWatchEyeOn}" StrokeThickness="1.3" />
                                <TextBlock VerticalAlignment="Center" Text="Access watch" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Padding="2,1"
                                    MinHeight="0"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding $parent[UserControl].DataContext.ToggleWatchCommand}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    IsEnabled="{Binding $parent[UserControl].DataContext.IsWriteEnabled}">
                                    <Panel>
                                        <Path Width="14" Height="14" Data="{StaticResource AccessWatchEyeIcon}" IsVisible="{Binding IsAccessWatch}" Stretch="Uniform" Stroke="{StaticResource AccessWatchEyeOn}" StrokeThickness="1.5" ToolTip.Tip="Watched: click to stop watching" />
                                        <Path Width="14" Height="14" Data="{StaticResource AccessWatchEyeIcon}" IsVisible="{Binding !IsAccessWatch}" Stretch="Uniform" Stroke="{StaticResource AccessWatchEyeOff}" StrokeThickness="1.5" ToolTip.Tip="Watch this tag" />
                                    </Panel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--
                        Section Type only: the Component box (Access Analyzer, 8f). The cell shows ComponentBoxChecked
                        (the stored value, or before the access-watch setup TermPoint's guess) and a click goes through
                        ToggleComponentCommand, which saves (then opens "which courses have it?") or asks under the list
                        first; the CheckBox itself takes no clicks, so it never shows an unsaved state. Disabled read-only.
                    -->
                    <DataGridTemplateColumn IsVisible="{Binding $parent[UserControl].DataContext.ShowComponentColumn}">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Background="Transparent" Text="Component" ToolTip.Tip="{Binding $parent[UserControl].DataContext.ComponentHeadingTip}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Padding="2,0"
                                    MinHeight="0"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding $parent[UserControl].DataContext.ToggleComponentCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding $parent[UserControl].DataContext.CanChangeComponents}">
                                    <CheckBox MinHeight="0" IsChecked="{Binding ComponentBoxChecked, Mode=OneWay}" IsHitTestVisible="False" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!--  Up/Down ordering buttons, aligned to top-right of the list  -->
            <StackPanel
                Grid.Column="1"
                Margin="6,0,0,0"
                VerticalAlignment="Top"
                Orientation="Vertical"
                Spacing="4">
                <Button Command="{Binding MoveUpCommand}" Content="↑" />
                <Button Command="{Binding MoveDownCommand}" Content="↓" />
            </StackPanel>

        </Grid>

        <!--  Toolbar — IsEnabled gates the entire group in read-only mode  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            IsEnabled="{Binding IsWriteEnabled}"
            IsVisible="{Binding EditVm, Converter={x:Static ObjectConverters.IsNull}}"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding AddCommand}" Content="Add" />
            <Button
                Command="{Binding EditCommand}"
                Content="Edit"
                IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button
                Command="{Binding DeleteCommand}"
                Content="Delete"
                IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <!--  Section Type: "Stop counting X as a component? It comes off A and B." (one at a time, under the list)  -->
        <Border
            Grid.Row="4"
            Margin="0,8,0,0"
            Padding="6,4"
            BorderBrush="{StaticResource TextFaint}"
            BorderThickness="1"
            CornerRadius="3"
            IsVisible="{Binding PendingAsk, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="4">
                <TextBlock FontSize="12" Text="{Binding PendingAsk.AskText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding PendingAsk.ConfirmUnmarkCommand}" Content="Stop counting it" />
                    <Button Command="{Binding PendingAsk.CancelUnmarkCommand}" Content="Cancel" />
                </StackPanel>
            </StackPanel>
        </Border>
        <!--  Inline error message  -->
        <TextBlock
            Grid.Row="5"
            FontSize="10"
            Foreground="{StaticResource TextError}"
            IsVisible="{Binding LastErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
            Text="{Binding LastErrorMessage}"
            TextWrapping="Wrap"
            Margin="0,4,0,0" />

    </Grid>
</UserControl>
