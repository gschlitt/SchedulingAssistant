<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TermPoint.Views.Management.ImportSectionsView"
             x:CompileBindings="False">

    <!--
        The Import Sections flyout (Files, Import Sections…). One panel per stage, each shown by the matching
        Is... property of ImportSectionsViewModel. There is deliberately no x:DataType: the view model is desktop
        only (it is not compiled into the browser build), and the other flyouts' reflection bindings are used here too.
        The flyout page already sits inside a ScrollViewer with a title bar (MainView), so this view adds neither;
        lists that can be long scroll in their own ScrollViewer, capped at ImportListMaxHeight (App.axaml).

        The first screen (ReadyToChoose) is an introduction and four numbered steps. The text of the steps and the
        instructions document is capped at ImportReadingMaxWidth and set in ImportReadingFontSize (both App.axaml),
        because the flyout is as wide as the window. Step 2 can expand the instructions in place; the Problems
        screen offers the same button. Both screens use the one ImportInstructionsTemplate below and the one
        ShowInstructions property of the view model, so they cannot drift apart and open or close together.
    -->

    <UserControl.Resources>
        <!-- One block of the instructions: a heading, a paragraph or a bullet. Each block has one of three
             panels visible (IsHeading / IsParagraph / IsBullet); the other two are collapsed. -->
        <DataTemplate x:Key="ImportInstructionBlockTemplate">
            <Panel>
                <TextBlock Margin="0,8,0,0"
                           FontSize="{StaticResource ImportReadingFontSize}"
                           FontWeight="{StaticResource FlyoutHeadingWeight}"
                           IsVisible="{Binding IsHeading}"
                           Text="{Binding Text}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="{StaticResource ImportReadingFontSize}"
                           IsVisible="{Binding IsParagraph}"
                           Text="{Binding Text}"
                           TextWrapping="Wrap" />
                <!-- The bullet sits in its own narrow column so wrapped lines align beside the text, not under the bullet.
                     The bullet is a plain punctuation glyph in a TextBlock, not an icon. -->
                <Grid Margin="8,3,0,0"
                      ColumnDefinitions="Auto,*"
                      IsVisible="{Binding IsBullet}">
                    <TextBlock Margin="0,0,8,0"
                               FontSize="{StaticResource ImportReadingFontSize}"
                               Text="&#x2022;" />
                    <TextBlock Grid.Column="1"
                               FontSize="{StaticResource ImportReadingFontSize}"
                               Text="{Binding Text}"
                               TextWrapping="Wrap" />
                </Grid>
            </Panel>
        </DataTemplate>

        <!-- The instructions document, defined once for both screens. Its content is the view model itself
             (Content="{Binding}"): a thin bordered box with the blocks, or the one "couldn't show" line when
             the instructions could not be read. No ScrollViewer: the flyout page already scrolls. -->
        <DataTemplate x:Key="ImportInstructionsTemplate">
            <Panel HorizontalAlignment="Left"
                   MaxWidth="{StaticResource ImportReadingMaxWidth}">
                <Border BorderBrush="{StaticResource TextFaint}"
                        BorderThickness="1"
                        CornerRadius="4"
                        IsVisible="{Binding InstructionsUnavailableText, Converter={x:Static ObjectConverters.IsNull}}"
                        Padding="10,8">
                    <ItemsControl ItemTemplate="{StaticResource ImportInstructionBlockTemplate}"
                                  ItemsSource="{Binding InstructionBlocks}" />
                </Border>
                <TextBlock FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextFaint}"
                           IsVisible="{Binding InstructionsUnavailableText, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding InstructionsUnavailableText}"
                           TextWrapping="Wrap" />
            </Panel>
        </DataTemplate>

        <!-- One line of a list (a section, course, instructor, setup value, problem or warning). -->
        <DataTemplate x:Key="ImportLineTemplate">
            <TextBlock FontSize="{StaticResource FontSizeSmall}"
                       Text="{Binding}"
                       TextWrapping="Wrap" />
        </DataTemplate>

        <!-- One kind of new setup value: its heading with a count, then its lines. -->
        <DataTemplate x:Key="ImportGroupTemplate">
            <StackPanel Margin="0,0,0,6" Spacing="1">
                <TextBlock FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="{StaticResource FlyoutHeadingWeight}">
                    <Run Text="{Binding Heading}" />
                    <Run Text="{Binding Count, StringFormat=' ({0})'}" />
                </TextBlock>
                <ItemsControl Margin="8,0,0,0"
                              ItemTemplate="{StaticResource ImportLineTemplate}"
                              ItemsSource="{Binding Items}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The expandable lists fill the flyout's width and use the small list font in their headers. -->
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="16,0" Spacing="8">

        <!-- ReadyToChoose only: what the import is for -->
        <TextBlock HorizontalAlignment="Left"
                   FontSize="{StaticResource FontSizeNormal}"
                   IsVisible="{Binding IsReadyToChoose}"
                   MaxWidth="{StaticResource ImportReadingMaxWidth}"
                   TextWrapping="Wrap">
            <Run Text="If you have semester schedules from previous years in spreadsheets, TermPoint can import them for you. In addition to sections, any courses, instructors, rooms and other section parameters that the spreadsheet names but TermPoint doesn't have yet will be added too." />
            <LineBreak />
            <Run Text="The first step is to prepare the spreadsheets (one per semester) containing your section data in a specified format." />
        </TextBlock>

        <!-- Always: the target semester -->
        <TextBlock FontSize="{StaticResource FontSizeNormal}"
                   Text="{Binding TargetLine}"
                   TextWrapping="Wrap" />

        <!-- Always: a short confirmation ("Template saved.", "Copied.") -->
        <TextBlock FontSize="{StaticResource FontSizeSmall}"
                   Foreground="{StaticResource TextFaint}"
                   IsVisible="{Binding HasStatusMessage}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />

        <!-- Always: the notice above a result ("something changed", "semester changed") -->
        <Border Background="{StaticResource NotificationInfoBackground}"
                BorderBrush="{StaticResource NotificationInfoBorder}"
                BorderThickness="1"
                CornerRadius="4"
                IsVisible="{Binding HasNotice}"
                Padding="8,6">
            <TextBlock FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource NotificationInfoText}"
                       Text="{Binding Notice}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Always: the inline error -->
        <TextBlock FontSize="{StaticResource FontSizeSmall}"
                   Foreground="{StaticResource TextError}"
                   IsVisible="{Binding LastErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding LastErrorMessage}"
                   TextWrapping="Wrap" />

        <!-- Stage: ReadyToChoose -->
        <StackPanel IsVisible="{Binding IsReadyToChoose}" Spacing="10">

            <!-- Step 1: the template -->
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Margin="0,0,10,0"
                           FontSize="{StaticResource ImportReadingFontSize}"
                           FontWeight="{StaticResource FlyoutHeadingWeight}"
                           Text="1" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock HorizontalAlignment="Left"
                               FontSize="{StaticResource ImportReadingFontSize}"
                               MaxWidth="{StaticResource ImportReadingMaxWidth}"
                               TextWrapping="Wrap">
                        <Run FontWeight="{StaticResource FlyoutHeadingWeight}" Text="First get the template." />
                        <Run Text=" An Excel workbook with the columns TermPoint needs and a few sample rows." />
                    </TextBlock>
                    <Button HorizontalAlignment="Left"
                            Padding="10,5"
                            Command="{Binding SaveTemplateCommand}"
                            Content="Save template&#x2026;"
                            FontSize="{StaticResource FontSizeNormal}" />
                </StackPanel>
            </Grid>

            <!-- Step 2: fill it in; the instructions expand in place under the buttons -->
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Margin="0,0,10,0"
                           FontSize="{StaticResource ImportReadingFontSize}"
                           FontWeight="{StaticResource FlyoutHeadingWeight}"
                           Text="2" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock HorizontalAlignment="Left"
                               FontSize="{StaticResource ImportReadingFontSize}"
                               MaxWidth="{StaticResource ImportReadingMaxWidth}"
                               TextWrapping="Wrap">
                        <Run FontWeight="{StaticResource FlyoutHeadingWeight}" Text="Fill it in according to the instructions below." />                        
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Padding="10,5"
                                Command="{Binding ToggleInstructionsCommand}"
                                Content="{Binding InstructionsToggleText}"
                                FontSize="{StaticResource FontSizeNormal}" />
                        <Button Padding="10,5"
                                Command="{Binding SaveInstructionsCommand}"
                                Content="Save instructions&#x2026;"
                                FontSize="{StaticResource FontSizeNormal}" />
                    </StackPanel>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource ImportInstructionsTemplate}"
                                    IsVisible="{Binding ShowInstructions}" />
                </StackPanel>
            </Grid>

            <!-- Step 3: choose the filled-in file -->
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Margin="0,0,10,0"
                           FontSize="{StaticResource ImportReadingFontSize}"
                           FontWeight="{StaticResource FlyoutHeadingWeight}"
                           Text="3" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock HorizontalAlignment="Left"
                               FontSize="{StaticResource ImportReadingFontSize}"
                               MaxWidth="{StaticResource ImportReadingMaxWidth}"
                               TextWrapping="Wrap">
                        <Run FontWeight="{StaticResource FlyoutHeadingWeight}" Text="Choose your file." />
                        <Run Text=" TermPoint checks the whole file before it adds anything. If something needs fixing, it lists the rows so you can correct them and try again." />
                    </TextBlock>
                    <Button HorizontalAlignment="Left"
                            Padding="10,5"
                            Command="{Binding ChooseFileCommand}"
                            Content="Choose file&#x2026;"
                            FontSize="{StaticResource FontSizeNormal}" />
                </StackPanel>
            </Grid>

            <!-- Step 4: what happens next (no button: the Import button appears on the next screen) -->
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Margin="0,0,10,0"
                           FontSize="{StaticResource ImportReadingFontSize}"
                           FontWeight="{StaticResource FlyoutHeadingWeight}"
                           Text="4" />
                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Left"
                           FontSize="{StaticResource ImportReadingFontSize}"
                           MaxWidth="{StaticResource ImportReadingMaxWidth}"
                           TextWrapping="Wrap">
                    <Run FontWeight="{StaticResource FlyoutHeadingWeight}" Text="Review and import." />
                    <Run Text=" You'll see everything that will be added. Nothing changes until you press Import." />
                </TextBlock>
            </Grid>

            <!-- Footer: why a second import is safe -->
            <TextBlock HorizontalAlignment="Left"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextFaint}"
                       MaxWidth="{StaticResource ImportReadingMaxWidth}"
                       Text="Sections already in the semester are skipped, so it's safe to import a corrected file again."
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Stage: Checking -->
        <TextBlock FontSize="{StaticResource FontSizeNormal}"
                   IsVisible="{Binding IsChecking}"
                   Text="Checking&#x2026;" />

        <!-- Stage: Problems -->
        <StackPanel IsVisible="{Binding IsProblems}" Spacing="8">
            <TextBlock FontSize="{StaticResource FontSizeNormal}"
                       FontWeight="{StaticResource FlyoutHeadingWeight}"
                       Text="{Binding ProblemsHeading}"
                       TextWrapping="Wrap" />
            <Border BorderBrush="{StaticResource TextFaint}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6">
                <ScrollViewer MaxHeight="{StaticResource ImportListMaxHeight}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemTemplate="{StaticResource ImportLineTemplate}"
                                  ItemsSource="{Binding ProblemLines}" />
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Padding="10,5"
                        Command="{Binding CopyListCommand}"
                        Content="Copy list"
                        FontSize="{StaticResource FontSizeNormal}" />
                <Button Padding="10,5"
                        Command="{Binding CheckAgainCommand}"
                        Content="Check again"
                        FontSize="{StaticResource FontSizeNormal}" />
                <Button Padding="10,5"
                        Command="{Binding ChooseFileCommand}"
                        Content="Choose file&#x2026;"
                        FontSize="{StaticResource FontSizeNormal}" />
                <Button Padding="10,5"
                        Command="{Binding ToggleInstructionsCommand}"
                        Content="{Binding InstructionsToggleText}"
                        FontSize="{StaticResource FontSizeNormal}" />
            </StackPanel>

            <!-- The same instructions document as step 2 of the first screen, below the buttons -->
            <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource ImportInstructionsTemplate}"
                            IsVisible="{Binding ShowInstructions}" />
        </StackPanel>

        <!-- Stage: ReadyToImport -->
        <StackPanel IsVisible="{Binding IsReadyToImport}" Spacing="8">
            <TextBlock FontSize="{StaticResource FontSizeNormal}"
                       Text="{Binding SummaryText}"
                       TextWrapping="Wrap" />
            <TextBlock FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextFaint}"
                       IsVisible="{Binding HasSkippedText}"
                       Text="{Binding SkippedText}"
                       TextWrapping="Wrap" />

            <!-- Expandable lists, collapsed by default -->
            <Expander Header="{Binding NewSections.Count, StringFormat='Sections ({0})'}">
                <ScrollViewer MaxHeight="{StaticResource ImportListMaxHeight}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemTemplate="{StaticResource ImportLineTemplate}"
                                  ItemsSource="{Binding NewSections}" />
                </ScrollViewer>
            </Expander>
            <Expander Header="{Binding NewCourses.Count, StringFormat='New courses ({0})'}"
                      IsVisible="{Binding HasNewCourses}">
                <ScrollViewer MaxHeight="{StaticResource ImportListMaxHeight}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemTemplate="{StaticResource ImportLineTemplate}"
                                  ItemsSource="{Binding NewCourses}" />
                </ScrollViewer>
            </Expander>
            <Expander Header="{Binding NewInstructors.Count, StringFormat='New instructors ({0})'}"
                      IsVisible="{Binding HasNewInstructors}">
                <ScrollViewer MaxHeight="{StaticResource ImportListMaxHeight}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemTemplate="{StaticResource ImportLineTemplate}"
                                  ItemsSource="{Binding NewInstructors}" />
                </ScrollViewer>
            </Expander>
            <Expander Header="New in TermPoint"
                      IsVisible="{Binding HasNewInTermPoint}">
                <ScrollViewer MaxHeight="{StaticResource ImportListMaxHeight}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemTemplate="{StaticResource ImportGroupTemplate}"
                                  ItemsSource="{Binding NewInTermPoint}" />
                </ScrollViewer>
            </Expander>

            <!-- Warnings (amber): they do not block the import -->
            <Border Background="{StaticResource NotificationWarningBackground}"
                    BorderBrush="{StaticResource NotificationWarningBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="{Binding HasWarnings}"
                    Padding="8,6">
                <ScrollViewer MaxHeight="{StaticResource ImportListMaxHeight}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,4"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource NotificationWarningText}"
                                           Text="{Binding}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Padding="10,5"
                        Command="{Binding ImportCommand}"
                        Content="Import"
                        FontSize="{StaticResource FontSizeNormal}"
                        ToolTip.ShowOnDisabled="True"
                        ToolTip.Tip="{Binding UnavailableReason}" />
                <Button Padding="10,5"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        FontSize="{StaticResource FontSizeNormal}" />
            </StackPanel>
        </StackPanel>

        <!-- Stage: NothingToAdd -->
        <StackPanel IsVisible="{Binding IsNothingToAdd}" Spacing="8">
            <TextBlock FontSize="{StaticResource FontSizeNormal}"
                       Text="{Binding NothingToAddText}"
                       TextWrapping="Wrap" />
            <Border Background="{StaticResource NotificationWarningBackground}"
                    BorderBrush="{StaticResource NotificationWarningBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="{Binding HasWarnings}"
                    Padding="8,6">
                <ScrollViewer MaxHeight="{StaticResource ImportListMaxHeight}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,4"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource NotificationWarningText}"
                                           Text="{Binding}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Button HorizontalAlignment="Left"
                    Padding="10,5"
                    Command="{Binding ChooseFileCommand}"
                    Content="Choose file&#x2026;"
                    FontSize="{StaticResource FontSizeNormal}" />
        </StackPanel>

        <!-- Stage: Done -->
        <StackPanel IsVisible="{Binding IsDone}" Spacing="8">
            <TextBlock FontSize="{StaticResource FontSizeNormal}"
                       Text="{Binding DoneMessage}"
                       TextWrapping="Wrap" />
            <ItemsControl IsVisible="{Binding HasDoneNotes}"
                          ItemsSource="{Binding DoneNotes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,0,4"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="{Binding}"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left"
                    Padding="10,5"
                    Command="{Binding ChooseFileCommand}"
                    Content="Choose file&#x2026;"
                    FontSize="{StaticResource FontSizeNormal}" />
        </StackPanel>

    </StackPanel>
</UserControl>
