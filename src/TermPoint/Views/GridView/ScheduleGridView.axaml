<UserControl
	x:Class="TermPoint.Views.GridView.ScheduleGridView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:TermPoint.Views.GridView"
	xmlns:vm="using:TermPoint.ViewModels.GridView"
	x:CompileBindings="False"
	x:DataType="vm:ScheduleGridViewModel">

	<UserControl.Styles>
		<Style Selector="Button.CtxMenuItem">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="10,5" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Button.CtxMenuItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ButtonHover}" />
		</Style>
		<Style Selector="CheckBox.CtxCheck">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Padding" Value="4,2" />
			<Setter Property="MinHeight" Value="0" />
		</Style>
		<Style Selector="ListBox.CtxList">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="2" />
		</Style>
		<Style Selector="ListBox.CtxList ListBoxItem">
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<!--  Events toggle checkbox style (moved from GridFilterView to sit after Access)  -->
		<Style Selector="CheckBox.EventsToggle">
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<ControlTemplate>
					<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Border
							x:Name="Box"
							Width="13"
							Height="13"
							Background="{StaticResource UserInteractionBrush}"
							BorderBrush="Black"
							BorderThickness="1"
							CornerRadius="2">
							<Path
								x:Name="Checkmark"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Data="M 1,5 L 4,8 L 9,2"
								IsVisible="False"
								Stroke="Black"
								StrokeThickness="1.5"
								StrokeLineCap="Round"
								StrokeJoin="Round" />
						</Border>
						<ContentPresenter
							VerticalAlignment="Center"
							Content="{TemplateBinding Content}"
							FontSize="{TemplateBinding FontSize}"
							Foreground="{TemplateBinding Foreground}" />
					</StackPanel>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="CheckBox.EventsToggle:checked /template/ Path#Checkmark">
			<Setter Property="IsVisible" Value="True" />
		</Style>
	</UserControl.Styles>

	<Grid
		Background="{StaticResource AppBackground}"
		RowDefinitions="Auto,Auto,*,Auto">

		<!--  Row 0: Filter bar + Events toggle - always visible (the Access watches moved to the Access tab)  -->
		<WrapPanel Grid.Row="0" Margin="0,0,0,4">
			<local:GridFilterView
				x:Name="GridFilterBar"
				MinHeight="28"
				DataContext="{Binding Filter}" />

			<!--  Events visibility toggle  -->
			<Border
				Margin="4,4.5,0,0"
				Padding="2,2,2,3"
				VerticalAlignment="Bottom"
				Background="{StaticResource AppBackground}"
				BorderThickness="0"
				CornerRadius="4">
				<CheckBox
					Classes="EventsToggle"
					BorderBrush="Black" BorderThickness="1"
					VerticalAlignment="Center"
					Content="Events"
					FontSize="{StaticResource FontSizeNormal}"
					IsChecked="{Binding Filter.ShowMeetings, Mode=TwoWay}"
					ToolTip.Tip="Show or hide events on the schedule grid" />
			</Border>
		</WrapPanel>

		<!--  Row 1: the open access watch's legend bar, then the error banner  -->
		<StackPanel Grid.Row="1">
		<!--
			The legend bar while an access watch is open (Access Analyzer, round 9): its name (and subset), the pins,
			Step through slates or the stepper, a quiet line when the filters hide some of its sections, Mark all
			conflicts and Close. Opening a watch sets the real filter bar to its tag (AccessWatchFilter), so there is no
			Show other courses box. DataContext: AccessLegendViewModel. Marks on the tiles explain themselves on hover,
			so the bar has no key (round 3).
		-->
		<Border
			Margin="0,0,0,4"
			Padding="{StaticResource AccessLegendPadding}"
			Background="{StaticResource AccessLegendBackground}"
			BorderBrush="{StaticResource AccessLegendBorder}"
			BorderThickness="1"
			CornerRadius="3"
			DataContext="{Binding AccessLegend}"
			IsVisible="{Binding IsVisible, FallbackValue=False}">
			<DockPanel>
				<Button
					Padding="6,1"
					MinHeight="0"
					VerticalAlignment="Center"
					Command="{Binding CloseCommand}"
					Content="{Binding CloseText}"
					DockPanel.Dock="Right"
					FontSize="{StaticResource FontSizePanelList}" />
				<CheckBox
					Margin="8,0,6,0"
					MinHeight="0"
					VerticalAlignment="Center"
					Content="Mark all conflicts"
					DockPanel.Dock="Right"
					FontSize="{StaticResource FontSizePanelList}"
					IsChecked="{Binding MarkAllConflicts}"
					ToolTip.Tip="Marks all conflicts, even those students can avoid by registering in different slates. Removing them can still improve access." />
				<WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
					<TextBlock
						Margin="0,0,10,0"
						VerticalAlignment="Center"
						FontSize="{StaticResource FontSizePanelList}"
						FontWeight="SemiBold"
						Foreground="{StaticResource TextPrimary}"
						Text="{Binding Title}" />
					<!--  Pins: chips with ✕, and Unpin all  -->
					<StackPanel
						Margin="0,0,10,0"
						VerticalAlignment="Center"
						IsVisible="{Binding HasPins}"
						Orientation="Horizontal"
						Spacing="4">
						<Path Width="9" Height="9" VerticalAlignment="Center" Data="{StaticResource PinIcon}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" />
						<TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizePanelList}" Foreground="{StaticResource TextSecondary}" Text="{Binding PinnedLead}" />
						<ItemsControl VerticalAlignment="Center" ItemsSource="{Binding PinChips}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button
										Padding="4,0"
										MinHeight="0"
										Command="{Binding UnpinCommand}"
										FontSize="{StaticResource FontSizePanelList}"
										ToolTip.Tip="Unpin">
										<StackPanel Orientation="Horizontal" Spacing="4">
											<TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
											<Path Width="7" Height="7" VerticalAlignment="Center" Data="{StaticResource RemoveIcon}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
										</StackPanel>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<Button Padding="6,0" MinHeight="0" Command="{Binding UnpinAllCommand}" Content="{Binding UnpinAllText}" FontSize="{StaticResource FontSizePanelList}" />
					</StackPanel>
					<Button
						Padding="6,1"
						MinHeight="0"
						VerticalAlignment="Center"
						Command="{Binding StartSteppingCommand}"
						Content="{Binding StepThroughText}"
						FontSize="{StaticResource FontSizePanelList}"
						IsVisible="{Binding CanStartStepping}" />
					<!--  The stepper: ‹ Slate i of N ›, the slate's sections by course, "mixes campuses", Clear  -->
					<StackPanel
						VerticalAlignment="Center"
						IsVisible="{Binding IsStepping}"
						Orientation="Horizontal"
						Spacing="6">
						<Button Padding="6,0" MinHeight="0" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanGoPrevious}" ToolTip.Tip="Previous slate"><Path Width="8" Height="8" Data="{StaticResource ChevronLeftIcon}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" /></Button>
						<TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizePanelList}" Foreground="{StaticResource TextPrimary}" Text="{Binding PositionText}" />
						<Button Padding="6,0" MinHeight="0" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" ToolTip.Tip="Next slate"><Path Width="8" Height="8" Data="{StaticResource ChevronRightIcon}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" /></Button>
						<ItemsControl VerticalAlignment="Center" ItemsSource="{Binding SlateParts}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal" Spacing="3">
										<TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizePanelList}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Text="{Binding CourseCode}" />
										<ItemsControl ItemsSource="{Binding Sections}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<StackPanel Orientation="Horizontal" Spacing="1">
														<Path Width="7" Height="7" VerticalAlignment="Center" Data="{StaticResource PinIcon}" Fill="{StaticResource TextSecondary}" IsVisible="{Binding IsPinned}" Stretch="Uniform" />
														<TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizePanelList}" Foreground="{StaticResource TextSecondary}" Text="{Binding Code}" />
													</StackPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBlock
							VerticalAlignment="Center"
							FontSize="{StaticResource FontSizePanelList}"
							Foreground="{StaticResource AccessMarkFragile}"
							IsVisible="{Binding MixesCampuses}"
							Text="{Binding MixesCampusesText}"
							ToolTip.Tip="{Binding MixesCampusesTip}" />
						<Button Padding="6,0" MinHeight="0" Command="{Binding ClearCommand}" Content="{Binding ClearText}" FontSize="{StaticResource FontSizePanelList}" />
					</StackPanel>
					<TextBlock
						Margin="10,0,0,0"
						VerticalAlignment="Center"
						FontSize="{StaticResource FontSizePanelList}"
						FontStyle="Italic"
						Foreground="{StaticResource TextFaint}"
						IsVisible="{Binding HasHiddenSections}"
						Text="{Binding HiddenSectionsText}" />
				</WrapPanel>
			</DockPanel>
		</Border>

		<!--  Error banner (only visible when LastErrorMessage is set)  -->
		<Border
			Padding="8,4"
			Background="{StaticResource ErrorBannerBackground}"
			BorderBrush="{StaticResource ErrorBannerBorder}"
			BorderThickness="0,0,0,1"
			IsVisible="{Binding LastErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<DockPanel>
				<Button
					Padding="4,1"
					Background="Transparent"
					BorderThickness="0"
					Command="{Binding DismissErrorCommand}"
					DockPanel.Dock="Right"
					ToolTip.Tip="Dismiss">
					<Viewbox Width="10" Height="10">
						<Path
							Fill="{StaticResource TextPrimary}"
							Data="{StaticResource RemoveIcon}" />
					</Viewbox>
				</Button>
				<TextBlock
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{StaticResource ErrorBannerText}"
					Text="{Binding LastErrorMessage}"
					TextTrimming="CharacterEllipsis"
					TextWrapping="NoWrap" />
			</DockPanel>
		</Border>
		</StackPanel>

		<!--  Row 2: Grid canvas with zoom transform  -->
		<ScrollViewer
			Grid.Row="2"
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto">
			<Border x:Name="ZoomContainer" HorizontalAlignment="Left">
				<Border.RenderTransform>
					<ScaleTransform ScaleX="1.0" ScaleY="1.0" />
				</Border.RenderTransform>
				<Canvas x:Name="GridCanvas" />
			</Border>
		</ScrollViewer>

		<!--  Row 3: Footer bar - license status (left) + tile font size + zoom controls (right)  -->
		<Border
			Grid.Row="3"
			Height="26"
			Padding="8,4"
			Background="{StaticResource ChromeBackground}"
			BorderBrush="{StaticResource ChromeBorder}"
			BorderThickness="0,1,0,0">
			<Grid>
				<!--  Left: license status  -->
				<StackPanel
					HorizontalAlignment="Left"
					Orientation="Horizontal"
					Spacing="6">
					<TextBlock
						VerticalAlignment="Center"
						FontSize="10"
						Foreground="{StaticResource TextSecondary}"
						Text="{Binding LicenseStatusText}" />
					<Button
						VerticalAlignment="Center"
						Background="Transparent"
						BorderThickness="0"
						Command="{Binding OpenPurchaseLinkCommand}"
						Cursor="Hand"
						IsVisible="{Binding ShowPurchaseLink}"
						Padding="0">
						<TextBlock
							FontSize="10"
							Foreground="{StaticResource WorkflowLinkText}"
							Text="Purchase license"
							TextDecorations="Underline" />
					</Button>
				</StackPanel>

				<!--  Right: tile font size + zoom controls  -->
			<StackPanel
				HorizontalAlignment="Right"
				Orientation="Horizontal"
				Spacing="4">
				<TextBlock
					VerticalAlignment="Center"
					FontSize="10"
					Foreground="{StaticResource TextPrimary}"
					Text="Text:" />
				<ComboBox
					x:Name="TileFontSizeBox"
					Width="52"
					Height="18"
					Padding="4,0"
					VerticalAlignment="Center"
					FontSize="10"
					ItemsSource="{Binding FontSizeOptions}"
					SelectedItem="{Binding TileFontSize, Mode=TwoWay}" />
				<TextBlock
					Margin="12,0,0,0"
					VerticalAlignment="Center"
					FontSize="10"
					Foreground="{StaticResource TextPrimary}"
					Text="Zoom:" />
				<Slider
					x:Name="ZoomSlider"
					Width="120"
					VerticalAlignment="Center"
					Maximum="2.5"
					Minimum="0.5"
					TickFrequency="0.1"
					TickPlacement="None" />
				<TextBlock
					x:Name="ZoomPercentLabel"
					Width="36"
					VerticalAlignment="Center"
					FontSize="10"
					Foreground="{StaticResource TextPrimary}"
					TextAlignment="Right" />
			</StackPanel>
			</Grid>
		</Border>

		<!--  Tile right-click context menu popup. Anchored at the right-click point, which the code-behind sets in
		      PlacementRect (see AnchorTileMenuAt), not Placement="Pointer": Pointer re-places the popup at the CURRENT
		      pointer whenever it resizes, so the whole menu jumped to the mouse when a long name scrolled into the
		      instructor list.  -->
		<Popup
			x:Name="TileContextPopup"
			Grid.RowSpan="4"
			IsLightDismissEnabled="True"
			IsOpen="{Binding ContextMenu.IsOpen, Mode=TwoWay}"
			Placement="AnchorAndGravity"
			PlacementAnchor="TopLeft"
			PlacementGravity="BottomRight">
			<Border
				Background="{StaticResource AppBackground}"
				BorderBrush="{StaticResource FilterExpanderBorder}"
				BorderThickness="1"
				BoxShadow="0 2 8 0 #33000000"
				CornerRadius="4">
				<StackPanel Orientation="Horizontal">

					<!--  Primary: 3 menu items  -->
					<StackPanel MinWidth="210">
						<!--  Details of the right-clicked section, shown to readers too (SectionContextMenuViewModel.FillDetails;
						      approved wording, Greg 2026-11-16).  -->
						<Grid
							MaxWidth="260"
							Margin="10,6,10,4"
							ColumnDefinitions="Auto,*"
							RowDefinitions="Auto,Auto,Auto,Auto,Auto">
							<TextBlock
								Grid.ColumnSpan="2"
								Margin="0,0,0,2"
								FontSize="{StaticResource FontSizeFilterPopup}"
								FontWeight="{StaticResource SectionHeadingFontWeight}"
								Foreground="{StaticResource TextPrimary}"
								Text="{Binding ContextMenu.DetailHeading}" />
							<TextBlock
								Grid.Row="1"
								Margin="0,0,4,0"
								FontSize="{StaticResource FontSizeFilterPopup}"
								Foreground="{StaticResource TextSecondary}"
								Text="{Binding ContextMenu.DetailInstructorLabel}" />
							<TextBlock
								Grid.Row="1"
								Grid.Column="1"
								FontSize="{StaticResource FontSizeFilterPopup}"
								Foreground="{StaticResource TextPrimary}"
								Text="{Binding ContextMenu.DetailInstructorNames}"
								TextWrapping="Wrap" />
							<TextBlock
								Grid.Row="2"
								Margin="0,0,4,0"
								FontSize="{StaticResource FontSizeFilterPopup}"
								Foreground="{StaticResource TextSecondary}"
								IsVisible="{Binding ContextMenu.DetailSectionType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Text="Type:" />
							<TextBlock
								Grid.Row="2"
								Grid.Column="1"
								FontSize="{StaticResource FontSizeFilterPopup}"
								Foreground="{StaticResource TextPrimary}"
								IsVisible="{Binding ContextMenu.DetailSectionType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Text="{Binding ContextMenu.DetailSectionType}"
								TextWrapping="Wrap" />
							<TextBlock
								Grid.Row="3"
								Margin="0,0,4,0"
								FontSize="{StaticResource FontSizeFilterPopup}"
								Foreground="{StaticResource TextSecondary}"
								IsVisible="{Binding ContextMenu.DetailDeliveryType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Text="Delivery:" />
							<TextBlock
								Grid.Row="3"
								Grid.Column="1"
								FontSize="{StaticResource FontSizeFilterPopup}"
								Foreground="{StaticResource TextPrimary}"
								IsVisible="{Binding ContextMenu.DetailDeliveryType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Text="{Binding ContextMenu.DetailDeliveryType}"
								TextWrapping="Wrap" />
							<TextBlock
								Grid.Row="4"
								Margin="0,0,4,0"
								FontSize="{StaticResource FontSizeFilterPopup}"
								Foreground="{StaticResource TextSecondary}"
								IsVisible="{Binding ContextMenu.DetailTags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Text="Tags:" />
							<TextBlock
								Grid.Row="4"
								Grid.Column="1"
								FontSize="{StaticResource FontSizeFilterPopup}"
								Foreground="{StaticResource TextPrimary}"
								IsVisible="{Binding ContextMenu.DetailTags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
								Text="{Binding ContextMenu.DetailTags}"
								TextWrapping="Wrap" />
						</Grid>
						<Border
							Height="1"
							Margin="6,0,6,2"
							Background="{StaticResource FilterExpanderBorder}" />
						<!--  Shown while a section card is open in the Section List: the edits below are disabled,
						      because saving would reload the list and discard the open card (SectionContextMenuViewModel.RefusalMessage).  -->
						<Border
							MaxWidth="210"
							Padding="10,5"
							Background="{StaticResource NotificationWarningBackground}"
							IsVisible="{Binding ContextMenu.RefusalMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
							<TextBlock
								FontSize="{StaticResource FontSizeFilterPopup}"
								Foreground="{StaticResource NotificationWarningText}"
								Text="{Binding ContextMenu.RefusalMessage}"
								TextWrapping="Wrap" />
						</Border>
						<Button Classes="CtxMenuItem" Command="{Binding ContextMenu.ShowInstructorsCommand}">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock VerticalAlignment="Center" Text="Assign Instructor to Section" />
								<TextBlock
									Margin="0,1,0,0"
									VerticalAlignment="Center"
									FontSize="9"
									Foreground="{StaticResource TextPrimary}"
									Text="▶" />
							</StackPanel>
						</Button>
						<Button Classes="CtxMenuItem" Command="{Binding ContextMenu.ShowRoomCommand}">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock VerticalAlignment="Center" Text="Assign Room to Section Booking" />
								<TextBlock
									Margin="0,1,0,0"
									VerticalAlignment="Center"
									FontSize="9"
									Foreground="{StaticResource TextPrimary}"
									Text="▶" />
							</StackPanel>
						</Button>
						<Button Classes="CtxMenuItem" Command="{Binding ContextMenu.ShowTagsCommand}">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock VerticalAlignment="Center" Text="Assign Tag to Section" />
								<TextBlock
									Margin="0,1,0,0"
									VerticalAlignment="Center"
									FontSize="9"
									Foreground="{StaticResource TextPrimary}"
									Text="▶" />
							</StackPanel>
						</Button>
							<Button Classes="CtxMenuItem" Command="{Binding ContextMenu.ShowFlagCommand}">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock VerticalAlignment="Center" Text="Set Flag on Section" />
									<TextBlock
										Margin="0,1,0,0"
										VerticalAlignment="Center"
										FontSize="9"
										Foreground="{StaticResource TextPrimary}"
										Text="▶" />
								</StackPanel>
							</Button>

						<!--  Marks: a bright frame on a section's lines, never saved. Enabled for readers and while a section
						      card is open, since they change nothing saved. Approved wording (Greg, 2026-11-16).  -->
						<Border
							Height="1"
							Margin="6,2"
							Background="{StaticResource FilterExpanderBorder}" />
						<Button
							Classes="CtxMenuItem"
							Command="{Binding ContextMenu.ToggleMarkCommand}"
							Content="{Binding ContextMenu.MarkItemText}" />
						<Button
							Classes="CtxMenuItem"
							Command="{Binding ContextMenu.ClearMarksCommand}"
							Content="Clear All Marks"
							IsVisible="{Binding ContextMenu.HasAnyMarks}" />
						<!--  While an access watch is open: pin this section in its slates, or unpin it (Access Analyzer)  -->
						<Border
							Height="1"
							Margin="6,2"
							Background="{StaticResource FilterExpanderBorder}"
							IsVisible="{Binding ContextMenu.HasPinItem}" />
						<Button
							Classes="CtxMenuItem"
							Command="{Binding ContextMenu.TogglePinCommand}"
							IsVisible="{Binding ContextMenu.HasPinItem}">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<Path Width="10" Height="10" VerticalAlignment="Center" Data="{StaticResource PinIcon}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" />
								<TextBlock VerticalAlignment="Center" Text="{Binding ContextMenu.PinItemText}" />
							</StackPanel>
						</Button>
						<!--  With no full slate: keep this section out of the move suggestions, or let it back in (never saved)  -->
						<Button
							Classes="CtxMenuItem"
							Command="{Binding ContextMenu.ToggleKeepInPlaceCommand}"
							Content="{Binding ContextMenu.KeepItemText}"
							IsVisible="{Binding ContextMenu.HasKeepItem}" />
					</StackPanel>

					<!--  Sub-panel: appears when a menu item is chosen  -->
					<Border
						MinWidth="180"
						MaxWidth="260"
						BorderBrush="{StaticResource FilterExpanderBorder}"
						BorderThickness="1,0,0,0"
						IsVisible="{Binding ContextMenu.HasSubPanel}">
						<DockPanel>

							<!--  OK / Cancel  -->
							<StackPanel
								Margin="6,4"
								HorizontalAlignment="Right"
								DockPanel.Dock="Bottom"
								Orientation="Horizontal"
								Spacing="4">
								<Button
									MinWidth="0"
									MinHeight="0"
									Padding="12,3"
									Command="{Binding ContextMenu.ConfirmCommand}"
									Content="OK"
									FontSize="11" />
								<Button
									MinWidth="0"
									MinHeight="0"
									Padding="12,3"
									Command="{Binding ContextMenu.CancelCommand}"
									Content="Cancel"
									FontSize="11" />
							</StackPanel>

							<!--  Lists  -->
							<ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
								<Panel>

									<!--  Instructors  -->
									<ListBox
										Classes="CtxList"
										IsVisible="{Binding ContextMenu.IsInstructorPanelVisible}"
										ItemsSource="{Binding ContextMenu.Instructors}"
										SelectionMode="Multiple">
										<!--
											Under chosen subjects, instructors outside them show lighter, under an
											"Other instructors" heading, as in the section editor's chooser. The class sits on the
											name's TextBlock so the CheckBox's own states cannot repaint it; this menu exists once,
											so the class style is cheap.
										-->
										<ListBox.Styles>
											<Style Selector="TextBlock.outOfFocus">
												<Setter Property="Foreground" Value="{StaticResource TextOutOfFocus}" />
											</Style>
										</ListBox.Styles>
										<ListBox.ItemTemplate>
											<DataTemplate>
												<StackPanel>
													<!--  "Other instructors" heading and thin rule, on the first out-of-focus row only  -->
													<Border
														Margin="0,3,0,2"
														Padding="2,2,0,0"
														BorderBrush="{StaticResource SubduedBorder}"
														BorderThickness="0,1,0,0"
														IsVisible="{Binding ShowOthersHeading}">
														<TextBlock
															FontSize="{StaticResource FontSizeSmall}"
															Foreground="{StaticResource TextDimLabel}"
															Text="Other instructors" />
													</Border>
													<CheckBox Classes="CtxCheck" IsChecked="{Binding IsChecked, Mode=TwoWay}">
														<TextBlock Classes.outOfFocus="{Binding IsOutOfFocus}" Text="{Binding Label}" />
													</CheckBox>
												</StackPanel>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>

									<!--  Room (single select)  -->
									<ListBox
										Classes="CtxList"
										IsVisible="{Binding ContextMenu.IsRoomPanelVisible}"
										ItemsSource="{Binding ContextMenu.Rooms}"
										SelectedItem="{Binding ContextMenu.SelectedRoom, Mode=TwoWay}"
										SelectionMode="Single">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<TextBlock
													Padding="4,2"
													FontSize="11"
													Text="{Binding Label}" />
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>

									<!--  Tags  -->
									<ListBox
										Classes="CtxList"
										IsVisible="{Binding ContextMenu.IsTagPanelVisible}"
										ItemsSource="{Binding ContextMenu.Tags}"
										SelectionMode="Multiple">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<CheckBox
													Classes="CtxCheck"
													Content="{Binding Label}"
													IsChecked="{Binding IsChecked, Mode=TwoWay}" />
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
									<!--  Flag (single select)  -->
									<ListBox
										Classes="CtxList"
										IsVisible="{Binding ContextMenu.IsFlagPanelVisible}"
										ItemsSource="{Binding ContextMenu.Flags}"
										SelectedItem="{Binding ContextMenu.SelectedFlag, Mode=TwoWay}"
										SelectionMode="Single">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal" Spacing="6">
													<Viewbox Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding HasIcon}">
														<Path Data="{StaticResource FlagIcon}" Fill="{Binding Brush}" />
													</Viewbox>
													<TextBlock Padding="4,2" FontSize="11" Text="{Binding Label}" />
												</StackPanel>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>

								</Panel>
							</ScrollViewer>
						</DockPanel>
					</Border>

				</StackPanel>
			</Border>
		</Popup>

		<!--
			Day header / folded strip right-click menu (collapse days): "Show only <day>", one "Show <pattern>" per block
			pattern, and "Show all days". Same look as the tile menu above. The lines' text, visibility and commands are
			prepared by DayHeaderMenuViewModel when the menu opens.
		-->
		<Popup
			x:Name="DayHeaderPopup"
			Grid.RowSpan="4"
			IsLightDismissEnabled="True"
			IsOpen="{Binding DayHeaderMenu.IsOpen, Mode=TwoWay}"
			Placement="Pointer">
			<Border
				Background="{StaticResource AppBackground}"
				BorderBrush="{StaticResource FilterExpanderBorder}"
				BorderThickness="1"
				BoxShadow="0 2 8 0 #33000000"
				CornerRadius="4">
				<StackPanel>
					<Button
						Classes="CtxMenuItem"
						Command="{Binding DayHeaderMenu.ShowOnlyCommand}"
						Content="{Binding DayHeaderMenu.ShowOnlyText}"
						IsVisible="{Binding DayHeaderMenu.ShowOnlyVisible}" />
					<ItemsControl ItemsSource="{Binding DayHeaderMenu.Patterns}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button
									Classes="CtxMenuItem"
									Command="{Binding ChooseCommand}"
									Content="{Binding Text}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button
						Classes="CtxMenuItem"
						Command="{Binding DayHeaderMenu.ShowAllCommand}"
						Content="Show all days"
						IsVisible="{Binding DayHeaderMenu.ShowAllVisible}" />
				</StackPanel>
			</Border>
		</Popup>

	</Grid>

</UserControl>
