<UserControl
	x:Class="TermPoint.Views.AccessTabView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="using:TermPoint.Behaviors"
	x:CompileBindings="False"
	b:DismissBehaviors.EscapeCommand="{Binding EscapeCommand}">

	<!--
		The Access tab (Access Analyzer, D17). DataContext: AccessTabViewModel. Three pages, one shown at a time:
		the list (notices, then one line per watched tag, worst first, Mark all conflicts at the foot), the detail of
		the open watch or of a course checked alone (DataContext Detail), and Check all courses (DataContext Check).
		The wording comes from the view models (AccessText). Marks are Paths shown by direct bools, never
		class-conditioned styles; chevrons are Paths too (the WASM fonts lack the glyphs). Escape backs out one page
		(the detail closes the open watch); the detail and Check pages take focus when shown so Escape reaches them
		(FocusWhenShownBehavior says why).
	-->
	<UserControl.Styles>
		<!--  A text link: no chrome, underlined text  -->
		<Style Selector="Button.alink">
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
			<Setter Property="FontSize" Value="{StaticResource FontSizePanelList}" />
		</Style>
		<Style Selector="Button.alink:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<!--  A small button in the tab  -->
		<Style Selector="Button.abtn">
			<Setter Property="Padding" Value="6,1" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="FontSize" Value="{StaticResource FontSizePanelList}" />
		</Style>
		<!--  A watch's row: the whole row opens it; a hover tint and the chevron say so  -->
		<Style Selector="Button.arow">
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="2" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Button.arow:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ButtonHover}" />
		</Style>
		<Style Selector="TextBlock.body">
			<Setter Property="FontSize" Value="{StaticResource FontSizePanelList}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.quiet">
			<Setter Property="FontSize" Value="{StaticResource FontSizePanelList}" />
			<Setter Property="Foreground" Value="{StaticResource TextFaint}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</UserControl.Styles>

	<Panel Margin="6,4,6,4">

		<!--  ═════════════ Page 1: the list ═════════════  -->
		<DockPanel IsVisible="{Binding IsListPage}">

			<!--  Header: the semester, Check all courses and Add a watch (only once set up; disabled read-only, its hover says why)  -->
			<DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
				<Button
					Classes="abtn"
					Margin="4,0,0,0"
					Command="{Binding AddWatchCommand}"
					Content="{Binding AddWatchButtonText}"
					DockPanel.Dock="Right"
					IsEnabled="{Binding CanAddWatch}"
					IsVisible="{Binding IsSetUp}"
					ToolTip.ShowOnDisabled="True"
					ToolTip.Tip="{Binding AddWatchTip}" />
				<Button
					Classes="abtn"
					Command="{Binding CheckAllCoursesCommand}"
					Content="{Binding CheckAllCoursesText}"
					DockPanel.Dock="Right" />
				<TextBlock
					VerticalAlignment="Center"
					FontSize="{StaticResource FontSizePanelList}"
					FontWeight="SemiBold"
					Foreground="{StaticResource TextSecondary}"
					Text="{Binding Title}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>

			<!--  Until access watches are set up (8f): the invite while editing, or the quiet read-only line  -->
			<Border
				Margin="0,0,0,6"
				Padding="6,4"
				BorderBrush="{StaticResource TextFaint}"
				BorderThickness="1"
				CornerRadius="3"
				DockPanel.Dock="Top"
				IsVisible="{Binding ShowSetupInvite}">
				<StackPanel Spacing="3">
					<TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding SetupInviteTitle}" />
					<!--  Set up at the left; the "What's an access watch?" link at the bottom right  -->
					<DockPanel>
						<Button Classes="abtn" Command="{Binding SetUpCommand}" Content="{Binding SetupInviteButton}" DockPanel.Dock="Left" />
						<Button Classes="alink" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding WhatIsAWatchCommand}">
							<TextBlock Text="{Binding WhatIsAWatchLink}" TextDecorations="Underline" />
						</Button>
					</DockPanel>
				</StackPanel>
			</Border>
			<TextBlock
				Classes="quiet"
				Margin="0,0,0,6"
				DockPanel.Dock="Top"
				IsVisible="{Binding ShowSetupReadOnlyLine}"
				Text="{Binding SetupReadOnlyText}" />

			<!--  Foot: Mark all conflicts (a view setting, remembered on this computer; works read-only; only once set up)  -->
			<CheckBox
				Margin="0,4,0,0"
				Content="{Binding MarkAllConflictsText}"
				DockPanel.Dock="Bottom"
				FontSize="{StaticResource FontSizePanelList}"
				IsChecked="{Binding MarkAllConflicts}"
				IsVisible="{Binding IsSetUp}"
				ToolTip.Tip="{Binding MarkAllConflictsTip}" />

			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<!--  Notices (rule 31), newest first: Open (that watch's detail) and ✕ (dismissed for this session)  -->
					<ItemsControl Margin="0,0,0,4" IsVisible="{Binding HasNotices}" ItemsSource="{Binding Notices}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Panel Margin="0,0,0,3">
									<!--  A bad notice has the attention border, good news the plain one (two borders, direct bools)  -->
									<Border Background="{StaticResource AccessNoticeBackground}" BorderBrush="{StaticResource AccessNoticeBadBorder}" BorderThickness="1" CornerRadius="3" IsVisible="{Binding IsBad}" />
									<Border Background="{StaticResource AccessNoticeBackground}" BorderBrush="{StaticResource AccessNoticeGoodBorder}" BorderThickness="1" CornerRadius="3" IsVisible="{Binding !IsBad}" />
									<DockPanel Margin="6,3">
										<Button Classes="alink" Margin="6,0,0,0" VerticalAlignment="Top" Command="{Binding DismissCommand}" DockPanel.Dock="Right" ToolTip.Tip="{Binding DismissTip}">
											<Path Width="8" Height="8" Margin="0,3,0,0" Data="{StaticResource RemoveIcon}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
										</Button>
										<Button Classes="alink" Margin="6,0,0,0" VerticalAlignment="Top" Command="{Binding OpenCommand}" DockPanel.Dock="Right">
											<TextBlock Text="{Binding OpenText}" TextDecorations="Underline" />
										</Button>
										<TextBlock Classes="body" Text="{Binding Text}" />
									</DockPanel>
								</Panel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!--  One line per watch: mark, name, health line (trimmed; the whole line on hover). Click opens its detail.  -->
					<ItemsControl IsVisible="{Binding HasRows}" ItemsSource="{Binding Rows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button
									Classes="arow"
									Command="{Binding $parent[ItemsControl].DataContext.OpenWatchCommand}"
									CommandParameter="{Binding}"
									ToolTip.Tip="{Binding HealthLine}">
									<Grid Margin="0,1" ColumnDefinitions="14,Auto,*,Auto">
										<Panel Grid.Column="0" VerticalAlignment="Center">
											<Path Width="9" Height="9" Data="{StaticResource AccessMarkAttentionIcon}" Fill="{StaticResource AccessMarkAttention}" IsVisible="{Binding IsAttention}" Stretch="Uniform" />
											<Path Width="8" Height="8" Data="{StaticResource AccessMarkFragileIcon}" Fill="{StaticResource AccessMarkFragile}" IsVisible="{Binding IsFragile}" Stretch="Uniform" />
											<Path Width="8" Height="8" Data="{StaticResource AccessMarkOkIcon}" Stroke="{StaticResource AccessMarkOk}" StrokeThickness="1.2" IsVisible="{Binding IsOk}" Stretch="Uniform" />
										</Panel>
										<TextBlock
											Grid.Column="1"
											Margin="0,0,8,0"
											VerticalAlignment="Center"
											FontSize="{StaticResource FontSizePanelList}"
											FontWeight="SemiBold"
											Foreground="{StaticResource TextPrimary}"
											Text="{Binding Name}" />
										<TextBlock
											Grid.Column="2"
											VerticalAlignment="Center"
											FontSize="{StaticResource FontSizePanelList}"
											Foreground="{StaticResource TextFaint}"
											Text="{Binding HealthLine}"
											TextTrimming="CharacterEllipsis" />
										<Path
											Grid.Column="3"
											Width="6"
											Height="6"
											Margin="6,0,2,0"
											VerticalAlignment="Center"
											Data="{StaticResource ChevronRightIcon}"
											Fill="{StaticResource TextFaint}"
											Stretch="Uniform" />
									</Grid>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</ScrollViewer>
		</DockPanel>

		<!--  ═════════════ Page 2: a watch's detail (or a course checked alone) ═════════════  -->
		<DockPanel b:FocusWhenShownBehavior.IsEnabled="True" DataContext="{Binding Detail}" IsVisible="{Binding $parent[UserControl].DataContext.IsDetailPage}">

			<!--  Header: back, name, Watching (click to stop watching; the tag stays)  -->
			<DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
				<Button Classes="alink" Margin="0,0,8,0" VerticalAlignment="Center" Command="{Binding BackCommand}" DockPanel.Dock="Left">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<Path Width="7" Height="7" VerticalAlignment="Center" Data="{StaticResource ChevronLeftIcon}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
						<TextBlock VerticalAlignment="Center" Text="{Binding BackText}" />
					</StackPanel>
				</Button>
				<Button
					Classes="abtn"
					Command="{Binding UnwatchCommand}"
					DockPanel.Dock="Right"
					IsEnabled="{Binding CanChange}"
					IsVisible="{Binding ShowWatching}"
					ToolTip.ShowOnDisabled="True"
					ToolTip.Tip="{Binding WatchingTip}">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<Path Width="12" Height="9" VerticalAlignment="Center" Data="{StaticResource AccessWatchEyeIcon}" Stroke="{StaticResource AccessWatchEyeOn}" StrokeThickness="1.4" Stretch="Uniform" />
						<TextBlock VerticalAlignment="Center" Text="{Binding WatchingText}" />
					</StackPanel>
				</Button>
				<TextBlock
					VerticalAlignment="Center"
					FontSize="{StaticResource FontSizePanelList}"
					FontWeight="SemiBold"
					Foreground="{StaticResource TextPrimary}"
					Text="{Binding Name}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>

			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="3">
					<!--  What the watch covers ("Watching the tag X: the sections carrying it.")  -->
					<TextBlock Classes="quiet">
						<Run Text="{Binding SourceLead}" /><Run FontWeight="SemiBold" Text="{Binding SourceName}" /><Run Text="{Binding SourceTail}" />
					</TextBlock>

					<!--  Several semesters (Q43): which one the detail shows  -->
					<ItemsControl IsVisible="{Binding HasSemesterChoice}" ItemsSource="{Binding SemesterChoices}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<ToggleButton Classes="abtn" Padding="6,1" MinHeight="0" Command="{Binding ChooseCommand}" Content="{Binding Name}" FontSize="{StaticResource FontSizePanelList}" IsChecked="{Binding IsSelected, Mode=OneWay}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!--  Health line (attention colour when there is no full slate or something is missing)  -->
					<TextBlock Classes="body" FontWeight="SemiBold" IsVisible="{Binding !IsHealthAttention}" Text="{Binding HealthLine}" />
					<TextBlock Classes="body" FontWeight="SemiBold" Foreground="{StaticResource AccessMarkAttention}" IsVisible="{Binding IsHealthAttention}" Text="{Binding HealthLine}" />

					<!--  Pins narrow the slates: a tinted banner at the top, so nobody wonders where their slates went  -->
					<Border Padding="6,3" Background="{StaticResource AccessPinBannerBackground}" CornerRadius="3" IsVisible="{Binding HasPins}">
						<DockPanel>
							<Button Classes="abtn" Command="{Binding UnpinAllCommand}" Content="{Binding UnpinAllText}" DockPanel.Dock="Right" />
							<WrapPanel VerticalAlignment="Center">
								<Path Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center" Data="{StaticResource PinIcon}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" />
								<TextBlock Classes="body" Margin="0,0,4,0" VerticalAlignment="Center" Text="{Binding PinBannerLead}" />
								<ItemsControl VerticalAlignment="Center" ItemsSource="{Binding PinChips}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Button Classes="abtn" Padding="4,0" Command="{Binding UnpinCommand}" ToolTip.Tip="{Binding UnpinTip}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
													<Path Width="7" Height="7" VerticalAlignment="Center" Data="{StaticResource RemoveIcon}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
												</StackPanel>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<TextBlock Classes="body" Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding PinBannerTail}" />
							</WrapPanel>
						</DockPanel>
					</Border>

					<!--  Flags: stranded, missing component, not counted, rule 8a (▲); cautions (◆)  -->
					<ItemsControl ItemsSource="{Binding Flags}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,1" ColumnDefinitions="14,*">
									<Panel Grid.Column="0" Margin="0,3,0,0" VerticalAlignment="Top">
										<Path Width="9" Height="9" Data="{StaticResource AccessMarkAttentionIcon}" Fill="{StaticResource AccessMarkAttention}" IsVisible="{Binding !IsCaution}" Stretch="Uniform" />
										<Path Width="8" Height="8" Data="{StaticResource AccessMarkCautionIcon}" Fill="{StaticResource AccessMarkFragile}" IsVisible="{Binding IsCaution}" Stretch="Uniform" />
									</Panel>
									<TextBlock Grid.Column="1" Classes="body" Text="{Binding Text}" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!--  8g: one very quiet line, never a list  -->
					<TextBlock Classes="quiet" FontStyle="Italic" IsVisible="{Binding ShowUntagged}" Text="{Binding UntaggedText}" />

					<!--  Courses: a tick box each (never saved; works read-only), the sections each offers the slates  -->
					<ItemsControl Margin="0,3,0,0" ItemsSource="{Binding Courses}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel>
									<Grid ColumnDefinitions="Auto,Auto,*">
										<CheckBox
											Grid.Column="0"
											MinHeight="0"
											Padding="2,0"
											VerticalAlignment="Center"
											IsChecked="{Binding IsTicked}"
											IsEnabled="{Binding IsTickEnabled}"
											ToolTip.ShowOnDisabled="True"
											ToolTip.Tip="{Binding TickTip}" />
										<TextBlock
											Grid.Column="1"
											Margin="0,0,8,0"
											VerticalAlignment="Center"
											FontSize="{StaticResource FontSizePanelList}"
											FontWeight="SemiBold"
											Foreground="{StaticResource TextPrimary}"
											Text="{Binding Code}" />
										<!--  "Lab: all 3 · Lecture: only A", a long one expandable ("4 of 8 ▸")  -->
										<ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Phrases}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<StackPanel Margin="0,0,8,0" Orientation="Horizontal">
														<TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizePanelList}" Foreground="{StaticResource TextFaint}" Text="{Binding Label}" />
														<TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizePanelList}" Foreground="{StaticResource TextSecondary}" IsVisible="{Binding !IsExpandable}" Text="{Binding Text}" />
														<Button Classes="alink" VerticalAlignment="Center" Command="{Binding $parent[ItemsControl].DataContext.TogglePhraseCommand}" CommandParameter="{Binding Key}" IsVisible="{Binding IsExpandable}">
															<StackPanel Orientation="Horizontal" Spacing="3">
																<TextBlock VerticalAlignment="Center" Text="{Binding Text}" TextDecorations="Underline" />
																<Path Width="6" Height="6" VerticalAlignment="Center" Data="{StaticResource ChevronRightIcon}" Fill="{StaticResource TextSecondary}" IsVisible="{Binding !IsExpanded}" Stretch="Uniform" />
																<Path Width="6" Height="6" VerticalAlignment="Center" Data="{StaticResource ChevronDownIcon}" Fill="{StaticResource TextSecondary}" IsVisible="{Binding IsExpanded}" Stretch="Uniform" />
															</StackPanel>
														</Button>
													</StackPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Grid>
									<ItemsControl Margin="22,0,0,0" ItemsSource="{Binding ExpandedLines}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<TextBlock Classes="quiet" Text="{Binding}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button Classes="alink" HorizontalAlignment="Left" Command="{Binding TickAllCommand}" IsVisible="{Binding ShowTickAll}">
						<TextBlock Text="{Binding TickAllText}" TextDecorations="Underline" />
					</Button>

					<!--  Round 6e: Multi-campus, quiet, under the courses; only when the watch's in-person sections span campuses  -->
					<CheckBox
						MinHeight="0"
						Content="{Binding MultiCampusLabel}"
						FontSize="{StaticResource FontSizePanelList}"
						IsChecked="{Binding MultiCampus}"
						IsEnabled="{Binding CanChange}"
						IsVisible="{Binding ShowMultiCampus}"
						ToolTip.ShowOnDisabled="True"
						ToolTip.Tip="{Binding MultiCampusTip}" />

					<TextBlock Classes="quiet" IsVisible="{Binding ShowStepHint}" Text="{Binding StepHint}" />

					<!--  Quieter facts, folded: "More about this watch (2)"  -->
					<Button Classes="alink" HorizontalAlignment="Left" Command="{Binding ToggleFoldCommand}" IsVisible="{Binding HasFacts}">
						<StackPanel Orientation="Horizontal" Spacing="3">
							<Path Width="6" Height="6" VerticalAlignment="Center" Data="{StaticResource ChevronRightIcon}" Fill="{StaticResource TextSecondary}" IsVisible="{Binding !IsFoldOpen}" Stretch="Uniform" />
							<Path Width="6" Height="6" VerticalAlignment="Center" Data="{StaticResource ChevronDownIcon}" Fill="{StaticResource TextSecondary}" IsVisible="{Binding IsFoldOpen}" Stretch="Uniform" />
							<TextBlock VerticalAlignment="Center" Text="{Binding FoldLabel}" />
						</StackPanel>
					</Button>
					<ItemsControl Margin="10,0,0,0" IsVisible="{Binding IsFoldOpen}" ItemsSource="{Binding Facts}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<TextBlock Classes="quiet" Text="{Binding}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock
						FontSize="{StaticResource FontSizePanelList}"
						Foreground="{StaticResource TextError}"
						IsVisible="{Binding LastErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						Text="{Binding LastErrorMessage}"
						TextWrapping="Wrap" />
				</StackPanel>
			</ScrollViewer>
		</DockPanel>

		<!--  ═════════════ Page 3: Check all courses (round 9) ═════════════  -->
		<DockPanel b:FocusWhenShownBehavior.IsEnabled="True" DataContext="{Binding Check}" IsVisible="{Binding $parent[UserControl].DataContext.IsCheckPage}">

			<DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
				<Button Classes="alink" Margin="0,0,8,0" VerticalAlignment="Center" Command="{Binding BackCommand}" DockPanel.Dock="Left">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<Path Width="7" Height="7" VerticalAlignment="Center" Data="{StaticResource ChevronLeftIcon}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
						<TextBlock VerticalAlignment="Center" Text="{Binding BackText}" />
					</StackPanel>
				</Button>
				<Button Classes="abtn" Command="{Binding RunCommand}" Content="{Binding CheckAgainText}" DockPanel.Dock="Right" IsVisible="{Binding CanCheckAgain}" />
				<TextBlock
					VerticalAlignment="Center"
					FontSize="{StaticResource FontSizePanelList}"
					FontWeight="SemiBold"
					Foreground="{StaticResource TextPrimary}"
					Text="{Binding Title}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>

			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="4">
					<!--  Before setup, nothing to check, or a failure: one line (quiet when read-only)  -->
					<StackPanel IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Spacing="3">
						<TextBlock Classes="quiet" IsVisible="{Binding NoticeIsQuiet}" Text="{Binding Notice}" />
						<TextBlock Classes="body" IsVisible="{Binding !NoticeIsQuiet}" Text="{Binding Notice}" />
						<Button Classes="abtn" HorizontalAlignment="Left" Command="{Binding SetUpCommand}" Content="{Binding SetUpButtonText}" IsVisible="{Binding ShowSetUpButton}" />
					</StackPanel>

					<TextBlock Classes="body" Foreground="{StaticResource NotificationWarningText}" IsVisible="{Binding IsOutOfDate}" Text="{Binding OutOfDateText}" />

					<!--  One block per loaded semester: headline, problem lines (click: the course on the grid), Worth a look  -->
					<ItemsControl ItemsSource="{Binding Semesters}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="0,0,0,6" Spacing="2">
									<TextBlock FontSize="{StaticResource FontSizePanelList}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" IsVisible="{Binding ShowName}" Text="{Binding SemesterName}" />
									<TextBlock Classes="body" FontWeight="SemiBold" IsVisible="{Binding !HeadlineIsAttention}" Text="{Binding Headline}" />
									<TextBlock Classes="body" FontWeight="SemiBold" Foreground="{StaticResource AccessMarkAttention}" IsVisible="{Binding HeadlineIsAttention}" Text="{Binding Headline}" />
									<ItemsControl ItemsSource="{Binding Problems}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Button
													Padding="0"
													MinHeight="0"
													HorizontalAlignment="Stretch"
													HorizontalContentAlignment="Stretch"
													Background="Transparent"
													BorderThickness="0"
													Command="{Binding OpenCommand}"
													Cursor="Hand"
													ToolTip.Tip="{Binding Tip}">
													<Grid Margin="0,1" ColumnDefinitions="14,*">
														<Path Grid.Column="0" Width="9" Height="9" Margin="0,3,0,0" VerticalAlignment="Top" Data="{StaticResource AccessMarkAttentionIcon}" Fill="{StaticResource AccessMarkAttention}" Stretch="Uniform" />
														<TextBlock Grid.Column="1" Classes="body" Text="{Binding Text}" />
													</Grid>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<StackPanel Margin="0,4,0,0" IsVisible="{Binding HasQuiet}" Spacing="1">
										<TextBlock Classes="quiet" FontWeight="SemiBold" Text="{Binding QuietHeading}" />
										<ItemsControl ItemsSource="{Binding Quiet}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<DockPanel Margin="0,1">
														<Button Classes="alink" Margin="6,0,0,0" VerticalAlignment="Top" Command="{Binding ActionCommand}" DockPanel.Dock="Right">
															<TextBlock Text="{Binding ActionText}" TextDecorations="Underline" />
														</Button>
														<TextBlock Classes="quiet" Text="{Binding Text}" />
													</DockPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
									<TextBlock Classes="quiet" IsVisible="{Binding Footer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding Footer}" />
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!--  Foot: what was checked, then Q28's line about labs set up as separate courses  -->
					<StackPanel IsVisible="{Binding HasRun}" Spacing="2">
						<TextBlock Classes="quiet" IsVisible="{Binding FooterLead, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding FooterLead}" />
						<TextBlock Classes="quiet" Text="{Binding SeparateLabsText}" />
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</DockPanel>
	</Panel>
</UserControl>
