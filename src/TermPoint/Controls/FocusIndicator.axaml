<UserControl
	x:Class="TermPoint.Controls.FocusIndicator"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:CompileBindings="False">

	<!--
		The reusable subject-focus statement (spec item 20; chips from 1.2.4 item 2.14):
		"Subjects: ■CIVL ■ECON ■MATH ■MECH ■PHYS ■STAT +9", large text in the standard colour (TextPrimary)
		and the normal weight of the header's academic unit and semester (only the panel title is bold). Each subject is a chip (marker + short
		name); the marker shows only while colour by subject is on. After FocusViewModel.IndicatorMaxChips chips the
		rest fold into "+N". Under None it reads "Subjects: none".

		Wrapping: "Subjects:" docks left and everything else wraps in the column beside it (a hanging indent), so the
		label is never left alone at the end of a line and lines break between chips, never inside one. Hosted in a
		header WrapPanel, the whole statement stays on the current line if it fits, otherwise starts its own line.
		The tooltip (IndicatorText) always lists every chosen subject, so "+N" can be read.

		DataContext = FocusViewModel (MainWindowViewModel.FocusVm). Hides itself (costing no space) under focus All.
		Display only: the subjects are changed from the top bar's Subjects picker.
	-->
	<DockPanel IsVisible="{Binding IsIndicatorVisible}" ToolTip.Tip="{Binding IndicatorText}">
		<TextBlock
			Margin="0,0,6,0"
			VerticalAlignment="Top"
			DockPanel.Dock="Left"
			FontSize="{StaticResource FontSizeLarge}"
			Foreground="{StaticResource TextPrimary}"
			Text="Subjects:" />

		<WrapPanel
			ItemSpacing="{StaticResource FocusChipSpacing}"
			LineSpacing="{StaticResource FocusChipLineSpacing}"
			Orientation="Horizontal">

			<!--  "none" under None, "some" when the subjects could not be read  -->
			<TextBlock
				VerticalAlignment="Center"
				FontSize="{StaticResource FontSizeLarge}"
				Foreground="{StaticResource TextPrimary}"
				IsVisible="{Binding HasIndicatorFallback}"
				Text="{Binding IndicatorFallbackText}" />

			<!--  The chips wrap inside their own WrapPanel, so a long list breaks between chips, never inside one  -->
			<ItemsControl VerticalAlignment="Center" ItemsSource="{Binding IndicatorChips}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel
							ItemSpacing="{StaticResource FocusChipSpacing}"
							LineSpacing="{StaticResource FocusChipLineSpacing}"
							Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel
							Orientation="Horizontal"
							Spacing="{StaticResource SubjectMarkerGap}"
							ToolTip.Tip="{Binding Label}">
							<Border
								Width="{StaticResource FocusChipMarkerSize}"
								Height="{StaticResource FocusChipMarkerSize}"
								VerticalAlignment="Center"
								Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
								BorderBrush="{StaticResource SubjectMarkerOutline}"
								BorderThickness="{StaticResource SubjectMarkerBorderThickness}"
								CornerRadius="{StaticResource SubjectMarkerCornerRadius}"
								IsVisible="{Binding HasColor}" />
							<TextBlock
								MaxWidth="{StaticResource FocusChipLabelMaxWidth}"
								VerticalAlignment="Center"
								FontSize="{StaticResource FontSizeLarge}"
								Foreground="{StaticResource TextPrimary}"
								Text="{Binding Label}"
								TextTrimming="CharacterEllipsis" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!--  "+N": the chosen subjects past the cap; the statement's tooltip lists them all  -->
			<TextBlock
				VerticalAlignment="Center"
				FontSize="{StaticResource FontSizeLarge}"
				Foreground="{StaticResource TextPrimary}"
				IsVisible="{Binding HasIndicatorMore}"
				Text="{Binding IndicatorMoreText}" />
		</WrapPanel>
	</DockPanel>
</UserControl>
